{
  "name": "@dsh-fly/dsh-plugin-fly-engagement",
  "version": "0.1.3",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "tools/index.js",
    "lib/fold.mjs",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-plugin-fly-engagement.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./tools/index.js": "./tools/index.js",
    "./lib/fold.mjs": "./lib/fold.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.spec.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepare": "node scripts/build-client.mjs"
  },
  "description": "DSH Fly engagement 记录面：eng_record/eng_state/eng_report + 抽屉面板（工作区 JSONL + 投影）",
  "homepage": "https://github.com/ethanchen669/dsh-plugin-fly-engagement#readme",
  "bugs": {
    "url": "https://github.com/ethanchen669/dsh-plugin-fly-engagement/issues"
  },
  "devDependencies": {
    "vite": "^5.4.21"
  }
}
